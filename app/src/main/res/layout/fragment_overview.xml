<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp">

    <TextView android:id="@+id/tvSummary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="15sp" android:layout_marginBottom="8dp" />

    <com.github.mikephil.charting.charts.PieChart android:id="@+id/pieCategory"
        android:layout_width="match_parent" android:layout_height="260dp" />

    <com.github.mikephil.charting.charts.LineChart android:id="@+id/lineMood"
        android:layout_width="match_parent" android:layout_height="220dp"
        android:layout_marginTop="12dp" />

    <com.github.mikephil.charting.charts.BarChart android:id="@+id/barExpenseTrend"
        android:layout_width="match_parent" android:layout_height="220dp"
        android:layout_marginTop="12dp" />
</LinearLayout>
</ScrollView>
