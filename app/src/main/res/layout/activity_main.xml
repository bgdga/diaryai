<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hi! What would you like to log?"
        android:textSize="20sp"
        android:layout_marginBottom="32dp" />

    <Button android:id="@+id/btnVoiceNote" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginBottom="12dp"
        android:text="1. Diary / Thoughts / Idea (voice)" />

    <Button android:id="@+id/btnExpense" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginBottom="12dp"
        android:text="2. Add Expense (voice)" />

    <Button android:id="@+id/btnDiaryMetrics" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginBottom="12dp"
        android:text="3. Today's Diary Metrics" />

    <Button android:id="@+id/btnDashboard" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. Dashboard / Reports" />

</LinearLayout>
