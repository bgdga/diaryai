<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- All storage is app-local (getExternalFilesDir) — no broad storage permission needed on API 26+ -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Diary AI"
        android:theme="@style/Theme.DiaryAI"
        android:supportsRtl="true">

        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.VoiceNoteActivity" android:exported="false" />
        <activity android:name=".ui.ExpenseVoiceActivity" android:exported="false" />
        <activity android:name=".ui.DiaryMetricsActivity" android:exported="false" />
        <activity android:name=".ui.DashboardActivity" android:exported="false" />

    </application>
</manifest>
